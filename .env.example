L4T_VERSION=36.4.4
BSP_URL=https://developer.nvidia.com/downloads/embedded/l4t/r36_release_v4.4/release/Jetson_Linux_R36.4.4_aarch64.tbz2
ROOTFS_URL=https://developer.nvidia.com/downloads/embedded/l4t/r36_release_v4.4/release/Tegra_Linux_Sample-Root-Filesystem_R36.4.4_aarch64.tbz2
BOARD=jetson-orin-nano-devkit-super
EXTERNAL_DEVICE=nvme0n1p1

# --- First-boot identity (baked into rootfs, skips oem-config wizard) -----
JETSON_USERNAME=jetson
JETSON_PASSWORD=jetson
JETSON_HOSTNAME=orin-nano

# --- Headless boot (no GUI; multi-user.target + tty autologin) ------------
JETSON_HEADLESS=true
JETSON_AUTOLOGIN=true

# --- Static IP (wired Ethernet, set blank to leave DHCP) ------------------
# Suggested: eth on its own subnet (direct cable to dev host), no gateway.
# WiFi carries default route to internet. Avoids two interfaces fighting
# over the same subnet.
JETSON_IFACE=eth0
JETSON_STATIC_IP=10.42.0.10/24
JETSON_GATEWAY=
JETSON_DNS=1.1.1.1,8.8.8.8

# --- WiFi (leave JETSON_WIFI_SSID blank to skip) --------------------------
# Orin Nano devkit needs an M.2 E-key WiFi card; Nano module has no radio.
# If JETSON_WIFI_STATIC_IP set, WiFi is static (DHCP knob ignored).
# WiFi default route uses metric 200 (acts as fallback when both ifaces
# carry default routes). With the suggested split-subnet eth has no gateway,
# so WiFi is the sole internet path.
JETSON_WIFI_IFACE=wlan0
JETSON_WIFI_SSID=
JETSON_WIFI_PSK=
JETSON_WIFI_DHCP=true
JETSON_WIFI_STATIC_IP=
JETSON_WIFI_GATEWAY=

# --- mDNS (avahi) so the host is reachable as <hostname>.local -----------
JETSON_AVAHI=true
