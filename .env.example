L4T_VERSION=39.2.0
BSP_URL=https://developer.nvidia.com/downloads/embedded/L4T/r39_Release_v2.0/release/Jetson_Linux_R39.2.0_aarch64.tbz2
ROOTFS_URL=https://developer.nvidia.com/downloads/embedded/L4T/r39_Release_v2.0/release/Tegra_Linux_Sample-Root-Filesystem_R39.2.0_aarch64.tbz2
BOARD=jetson-orin-nano-devkit-super
EXTERNAL_DEVICE=nvme0n1p1

# --- First-boot identity (baked into rootfs, skips oem-config wizard) -----
JETSON_USERNAME=jetson
JETSON_PASSWORD=jetson
JETSON_HOSTNAME=orin-nano

# --- Headless boot (no GUI; multi-user.target + tty autologin) ------------
JETSON_HEADLESS=true
JETSON_AUTOLOGIN=true

# --- Wired Ethernet (set JETSON_STATIC_IP blank to leave DHCP) -----------
# Jetson uses PCIe predictable iface names, not eth0. Defaults below are
# correct for the Orin Nano devkit. For other modules, boot the stock
# image, run `ip -br link`, and override JETSON_ETH_DEV here.
# Suggested layout: eth on its own subnet (direct cable to dev host),
# no gateway → WiFi carries the default route.
JETSON_ETH_DEV=enP8p1s0
JETSON_STATIC_IP=10.42.0.10/24
JETSON_GATEWAY=
JETSON_DNS=1.1.1.1,8.8.8.8

# --- WiFi (leave JETSON_WIFI_SSID blank to skip) -------------------------
# Orin Nano devkit needs an M.2 E-key WiFi card; the Nano module has no
# radio. JETSON_WIFI_DEV blank → NetworkManager matches by SSID only
# (works regardless of WiFi card vendor / iface name).
# If JETSON_WIFI_STATIC_IP set, WiFi is static (DHCP knob ignored).
# WiFi default route uses metric 200 (lower priority than eth gateway
# if both ifaces carry default routes; with split-subnet eth has none
# so WiFi is sole internet path).
JETSON_WIFI_DEV=
JETSON_WIFI_SSID=
JETSON_WIFI_PSK=
JETSON_WIFI_DHCP=true
JETSON_WIFI_STATIC_IP=
JETSON_WIFI_GATEWAY=

# --- mDNS (avahi) so the host is reachable as <hostname>.local -----------
JETSON_AVAHI=true
